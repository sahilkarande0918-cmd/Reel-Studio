{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "default": "",
      "type": "string",
      "maxLength": 120
    },
    "fps": {
      "default": 30,
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source": {
      "default": {},
      "type": "object",
      "properties": {
        "recordingId": {
          "type": "string"
        },
        "highlightId": {
          "type": "string"
        },
        "editId": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "image",
              "font"
            ]
          },
          "src": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "duration": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "src"
        ]
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "caption",
              "text",
              "overlay"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "video"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sourceStart": {
                      "type": "number",
                      "minimum": 0
                    },
                    "sourceEnd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volume": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3.98
                    },
                    "fadeIn": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    },
                    "fadeOut": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    },
                    "transition": {
                      "default": "none",
                      "type": "string",
                      "enum": [
                        "none",
                        "fade",
                        "slide",
                        "zoom"
                      ]
                    },
                    "cropKeyframes": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "t": {
                            "type": "number",
                            "minimum": 0
                          },
                          "crop_x": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "crop_y": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "crop_width": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "crop_height": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "layout": {
                            "type": "string",
                            "enum": [
                              "crop",
                              "panel"
                            ]
                          },
                          "region": {
                            "type": "string"
                          },
                          "transition_mode": {
                            "type": "string",
                            "enum": [
                              "start",
                              "hold",
                              "ease",
                              "cut",
                              "manual"
                            ]
                          }
                        },
                        "required": [
                          "t",
                          "crop_x",
                          "crop_y",
                          "crop_width",
                          "crop_height",
                          "layout",
                          "region",
                          "transition_mode"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "assetId",
                    "start",
                    "duration",
                    "sourceStart",
                    "sourceEnd",
                    "cropKeyframes"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "caption"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "words": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          },
                          "isCode": {
                            "default": false,
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "text",
                          "start",
                          "end"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "start",
                    "duration",
                    "words"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "audio"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sourceStart": {
                      "type": "number",
                      "minimum": 0
                    },
                    "sourceEnd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volume": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3.98
                    },
                    "fadeIn": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    },
                    "fadeOut": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "assetId",
                    "start",
                    "duration",
                    "sourceStart",
                    "sourceEnd"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "code"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "language": {
                      "type": "string",
                      "enum": [
                        "json",
                        "xml",
                        "javascript",
                        "typescript",
                        "python",
                        "sql",
                        "html",
                        "css",
                        "text"
                      ]
                    },
                    "title": {
                      "default": "",
                      "type": "string",
                      "maxLength": 120
                    },
                    "code": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "typingDuration": {
                      "default": 2,
                      "type": "number",
                      "minimum": 0
                    },
                    "changes": {
                      "default": [],
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "at": {
                            "type": "number",
                            "minimum": 0
                          },
                          "code": {
                            "type": "string",
                            "maxLength": 12000
                          },
                          "typingDuration": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "at",
                          "code",
                          "typingDuration"
                        ]
                      }
                    },
                    "transition": {
                      "default": "none",
                      "type": "string",
                      "enum": [
                        "none",
                        "fade",
                        "slide",
                        "zoom"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "start",
                    "duration",
                    "language",
                    "code"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "x": {
                      "default": 80,
                      "type": "number"
                    },
                    "y": {
                      "default": 180,
                      "type": "number"
                    },
                    "fontSize": {
                      "default": 64,
                      "type": "integer",
                      "minimum": 12,
                      "maximum": 200
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "align": {
                      "default": "left",
                      "type": "string",
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    },
                    "box": {
                      "default": false,
                      "type": "boolean"
                    },
                    "transition": {
                      "default": "none",
                      "type": "string",
                      "enum": [
                        "none",
                        "fade",
                        "slide",
                        "zoom"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "start",
                    "duration",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "motion"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "template": {
                      "type": "string",
                      "pattern": "^[a-z_]{2,40}$"
                    },
                    "fields": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 400
                      }
                    },
                    "media": {
                      "default": [],
                      "maxItems": 6,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "intensity": {
                      "default": 0.6,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "track": {
                      "maxItems": 900,
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        ],
                        "items": false,
                        "minItems": 3,
                        "maxItems": 3
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "start",
                    "duration",
                    "template"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "items"
        ]
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "default": "",
          "type": "string",
          "maxLength": 80
        },
        "handle": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "colors": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "background",
            "text",
            "accent"
          ]
        },
        "fonts": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "enum": [
                "Archivo",
                "Poppins",
                "Noto Sans"
              ]
            },
            "code": {
              "type": "string",
              "enum": [
                "JetBrains Mono",
                "Fira Code"
              ]
            }
          },
          "required": [
            "body",
            "code"
          ]
        },
        "logoAssetId": {
          "type": "string",
          "minLength": 1
        },
        "watermark": {
          "default": {
            "enabled": false,
            "position": "top-right"
          },
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "position": {
              "type": "string",
              "enum": [
                "top-left",
                "top-right",
                "bottom-left",
                "bottom-right"
              ]
            }
          },
          "required": [
            "enabled",
            "position"
          ]
        },
        "intro": {
          "default": {
            "enabled": false,
            "duration": 2,
            "title": ""
          },
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "duration": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "title": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "enabled",
            "duration",
            "title"
          ]
        },
        "outro": {
          "default": {
            "enabled": false,
            "duration": 3,
            "cta": ""
          },
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "duration": {
              "type": "number",
              "minimum": 1,
              "maximum": 6
            },
            "cta": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "enabled",
            "duration",
            "cta"
          ]
        }
      },
      "required": [
        "colors",
        "fonts"
      ]
    },
    "captionStyle": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "preset": {
          "default": "highlight-word",
          "type": "string",
          "enum": [
            "highlight-word",
            "karaoke",
            "boxed"
          ]
        },
        "look": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,40}$"
            },
            "font": {
              "type": "string",
              "enum": [
                "Archivo",
                "Poppins",
                "Noto Sans",
                "Fraunces",
                "Bebas Neue",
                "Caveat",
                "Press Start 2P",
                "JetBrains Mono",
                "Fira Code"
              ]
            },
            "uppercase": {
              "default": false,
              "type": "boolean"
            },
            "italic": {
              "default": false,
              "type": "boolean"
            },
            "sizeScale": {
              "default": 1,
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.8
            },
            "tracking": {
              "default": 0,
              "type": "number",
              "minimum": -0.05,
              "maximum": 0.3
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "active": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "chip": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "stroke": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "strokeColor": {
              "default": "#000000",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "shadow": {
              "default": "soft",
              "type": "string",
              "enum": [
                "none",
                "soft",
                "hard",
                "long"
              ]
            },
            "glow": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "highlight": {
              "default": "fill",
              "type": "string",
              "enum": [
                "fill",
                "chip",
                "karaoke",
                "underline",
                "scale",
                "none"
              ]
            },
            "entrance": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "pop",
                "bounce",
                "slide",
                "fade",
                "blur",
                "drop",
                "swing",
                "typewriter",
                "wave",
                "zoom"
              ]
            },
            "box": {
              "default": false,
              "type": "boolean"
            },
            "position": {
              "default": "lower",
              "type": "string",
              "enum": [
                "lower",
                "middle",
                "upper"
              ]
            }
          },
          "required": [
            "id",
            "font",
            "color",
            "active"
          ]
        },
        "fontSize": {
          "default": 64,
          "type": "integer",
          "minimum": 24,
          "maximum": 120
        },
        "maxCharsPerLine": {
          "default": 32,
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "maxLines": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "safeTop": {
          "default": 1350,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "safeBottom": {
          "default": 1650,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "stylePreset": {
      "default": "focus",
      "type": "string",
      "enum": [
        "focus",
        "energy",
        "story",
        "signature"
      ]
    },
    "renderSettings": {
      "type": "object",
      "properties": {
        "quality": {
          "default": "looks",
          "type": "string",
          "enum": [
            "draft",
            "looks",
            "delivery"
          ]
        }
      }
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "width",
    "height",
    "duration",
    "assets",
    "tracks",
    "brand",
    "captionStyle",
    "renderSettings"
  ]
}
